# Server
NODE_ENV=development
PORT=3000
COOKIE_SECRET=change-me-in-production-min-32-chars

# MongoDB
MONGO_URI=mongodb://localhost:27017/garment_erp

# Sessions
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Argon2id (raise these over time; see docs/adr)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Company / numbering defaults used by the seed script
COMPANY_LEGAL_NAME=Demo Garment Co
COMPANY_STATE=Maharashtra
COMPANY_GSTIN=27AAAAA0000A1Z5
CURRENT_FINANCIAL_YEAR=26-27
